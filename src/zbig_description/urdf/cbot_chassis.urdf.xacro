<?xml version="1.0"?>
<robot name="zbig" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:property name="wheel_radius" value="0.074"/>
    <xacro:property name="wheel_offset_y" value="0.15283"/>
    <xacro:property name="wheel_offset_z" value="0.0"/>

    <xacro:property name="caster_wheel_radius" value="0.0254"/>   
    <xacro:property name="caster_wheel_offset_x" value="0.137"/>
    <xacro:property name="caster_wheel_offset_y" value="0.0"/>
    <xacro:property name="caster_wheel_offset_z" value="${wheel_offset_z - wheel_radius + caster_wheel_radius}"/>

    <xacro:property name="chassis_mass" value="10.0"/>
    <xacro:property name="wheel_mass" value="0.05"/>
    <xacro:property name="caster_wheel_mass" value="0.01"/>

  <!-- BASE_FOOTPRINT LINK -->

  <link name="base_footprint"></link>

   <!-- JOINTS -->

   <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link" />
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <joint name="wheel_right_joint" type="continuous">
    <origin xyz="0 ${-wheel_offset_y} 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="wheel_right_link" />
    <axis xyz="0 1 0" />
  </joint>
  
  <joint name="wheel_left_joint" type="continuous">
    <origin xyz="0 ${wheel_offset_y}  0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="wheel_left_link" />
    <axis xyz="0 1 0" />
  </joint>

  <joint name="caster_rear_joint" type="fixed">
    <origin xyz="${-caster_wheel_offset_x} ${-caster_wheel_offset_y} ${caster_wheel_offset_z}" rpy="1.57 0 1.57" />
    <parent link="base_link" />
    <child link="caster_rear_link" />
    <axis xyz="0 0 0" />
  </joint>

  <joint name="caster_front_joint" type="fixed">
    <origin xyz="${caster_wheel_offset_x} ${caster_wheel_offset_y} ${caster_wheel_offset_z}" rpy="1.57 0 1.57" />
    <parent link="base_link" />
    <child link="caster_front_link" />
    <axis xyz="0 0 0" />
  </joint>


<!-- LINKS -->

   <!-- BASE LINK -->

  <link name="base_link">
    <inertial>
      <origin xyz="-0.070489 -0.000718 0.040699" rpy="0.0 0.0 0.0" />
      <mass value="${chassis_mass}"/>
      <inertia ixx="0.011114" ixy="0.000188" ixz="-0.005821"
               iyy="0.017229" iyz="0.000127"
               izz="0.019734" />
    </inertial>
    <visual name='base_link_visual'>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find zbig_description)/meshes/cbot/collision-chassis-center1.stl" />
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find zbig_description)/meshes/cbot/collision-chassis-center1.stl" />
      </geometry>
    </collision>
  </link>

<!-- RIGHT WHEEL LINK -->

  <link name="wheel_right_link">
    <inertial>
      <origin xyz="0 -0.014 0" rpy="0 0 0" />
      <mass value="${wheel_mass}" />
      <inertia ixx="1.88176298336665E-05" ixy="-4.8444933029987E-10" ixz="1.88163708851143E-08"
               iyy="3.11510738647764E-05" iyz="-6.93560663069607E-11"
               izz="1.8801969558182E-05" />
    </inertial>
    <visual>
      <origin xyz="-0.0 0.014 0.0" rpy="1.57 0 0" />
      <geometry>
        <mesh filename="file://$(find zbig_description)/meshes/cbot/collision-6inch-wheel.stl" />
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57 0 0" />
      <geometry>
        <sphere radius="${wheel_radius}"/>
      </geometry>
    </collision>
  </link>

  <!-- LEFT WHEEL LINK -->

  <link
    name="wheel_left_link">
    <inertial>
      <origin xyz="0 -0.014 0" rpy="0 0 0" />
      <mass value="${wheel_mass}" />
      <inertia ixx="1.8792911368909E-05"  ixy="3.31256392204584E-10" ixz="-1.14082001662767E-08"
               iyy="3.11510738759073E-05" iyz="-3.60499245082192E-10"
               izz="1.88266886146847E-05" />
    </inertial>
    <visual>
      <origin xyz="0 -0.014 0" rpy="-1.57 0 0" />
      <geometry>
        <mesh filename="file://$(find zbig_description)/meshes/cbot/collision-6inch-wheel.stl" />
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="-1.57 0 0" />
      <geometry>
        <sphere radius="${wheel_radius}"/>
      </geometry>
    </collision>
  </link>

  <!-- REAR CASTER WHEEL LINK -->

  <link name="caster_rear_link">
    <inertial>
      <origin xyz=".000112 -0.0155 -.00818" rpy="0 0 0" />
      <mass value="0.027976" />
      <inertia ixx="0.000019" ixy="0" ixz="0"
               iyy="0.000007"  iyz="0.000006"
               izz="0.000014" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find zbig_description)/meshes/cbot/visual-caster-2inch.stl" />
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="${caster_wheel_radius}"/>
      </geometry>
    </collision>
  </link>

  <!-- FRONT CASTER WHEEL LINK -->  
  
  <link name="caster_front_link">
    <inertial>
      <origin xyz=".000112 -0.0155 -.00818" rpy="0 0 0" />
      <mass value="0.027976" />
      <inertia ixx="0.000019" ixy="0" ixz="0"
               iyy="0.000007"  iyz="0.000006"
               izz="0.000014" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find zbig_description)/meshes/cbot/visual-caster-2inch.stl" />
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="${caster_wheel_radius}"/>
      </geometry>
    </collision>
  </link>

    <!-- Wheels -->
  <gazebo reference="wheel_left_link">
    <mu1>1000000000000000.0</mu1>
    <mu2>1000000000000000.0</mu2>
    <kp>1000000000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="wheel_right_link">
    <mu1>1000000000000000.0</mu1>
    <mu2>1000000000000000.0</mu2>
    <kp>1000000000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>
    
  <!-- Caster Wheels -->
  <gazebo reference="caster_rear_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>
    
  <gazebo reference="caster_front_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

</robot>