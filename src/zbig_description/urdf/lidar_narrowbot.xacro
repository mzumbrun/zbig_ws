<?xml version="1.0"?>

<robot name="zbig" xmlns:xacro="http://ros.org/wiki/xacro">

   <xacro:property name="lidar_roll" value="0.0"/>
   <xacro:property name="lidar_pitch" value="0.0"/>
   <xacro:property name="lidar_yaw" value="0.00"/>

  <!-- LIDAR JOINT -->

  <joint name="laser_joint" type="fixed">
    <origin xyz="-0.013456 0.000513 0.140452" rpy="${lidar_roll} ${lidar_pitch} ${lidar_yaw}" />
    <parent link="base_link" />
    <child link="laser_frame" />
    <axis xyz="0 0 0" />
  </joint>

  <!-- LIDAR LINK -->

  <link name="laser_frame">
    <inertial>
      <origin xyz="0.005399 -0.010876 0.002517" rpy="0 0 ${lidar_yaw}" />
      <mass value="0.07308" />
      <inertia ixx="0.000039" ixy="-0.000011" ixz="0.000003"
               iyy="0.000063" iyz="-0.000005"
               izz="0.000057" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 3.14" />
      <geometry>
        <mesh filename="file://$(find zbig_description)/meshes/narrowbot/collision-lidar.stl" />
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${lidar_roll} ${lidar_pitch} ${lidar_yaw}" />
      <geometry>
        <mesh filename="file://$(find zbig_description)/meshes/narrowbot/collision-lidar.stl" />
      </geometry>
    </collision>
  </link>

     <!-- LIDAR Gazebo -->

   <gazebo reference="laser_frame">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <topic>scan</topic>
      <update_rate>5</update_rate>
      <gz_frame_id>laser_frame</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.00000</resolution>
            <min_angle>-2.2</min_angle>
            <max_angle>2.2</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.120000</min>
          <max>12.0</max>
          <resolution>0.02</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>     
  </gazebo>
</robot>